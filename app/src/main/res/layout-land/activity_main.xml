<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="7dp"
        android:layout_weight="1.15"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingBottom="10dp">
            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:textColor="@color/fg"
                android:textSize="46sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="@color/muted"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/updateBanner"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Update klaar"
                android:textColor="@color/amber_ink"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:minWidth="64dp"
                android:background="@drawable/bg_round_amber"
                android:contentDescription="Spraakopdracht geven"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/mediaCard"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="0dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="NU SPEELT"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/albumArt"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:background="@drawable/bg_tile"
                    android:clipToOutline="true"
                    android:importantForAccessibility="no"
                    android:padding="0dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_music" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/trackTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/fg"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/trackArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/muted"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/mediaHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tile"
                android:padding="12dp"
                android:text="Tik hier om songtitels en hoesjes te tonen (eenmalig instellen)"
                android:textColor="@color/amber"
                android:textSize="15sp"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_round_dark"
                    android:contentDescription="Vorige"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_prev" />
                <ImageButton
                    android:id="@+id/btnPlay"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginStart="28dp"
                    android:layout_marginEnd="28dp"
                    android:background="@drawable/bg_round_amber"
                    android:contentDescription="Afspelen of pauzeren"
                    android:padding="24dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play" />
                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_round_dark"
                    android:contentDescription="Volgende"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="0dp"
            android:orientation="horizontal">
            <include
                android:id="@+id/tileSpotify"
                layout="@layout/tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />
            <include
                android:id="@+id/tileMaps"
                layout="@layout/tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <include
                android:id="@+id/tileFlits"
                layout="@layout/tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />
            <include
                android:id="@+id/tileWhatsapp"
                layout="@layout/tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.55" android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/destHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thuis"
                    android:textColor="@color/go"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/destHomeAddr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/destWork"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="School / werk"
                    android:textColor="@color/go"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/destWorkAddr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
